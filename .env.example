# Copy to .env. Never commit real credentials.
# OPENAI is accepted as an alias for both OpenAI credential variables below.
OPENAI=
LLM_API_KEY=
LLM_PROVIDER=openai
# Set a model supported by your provider/account.
LLM_MODEL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=
TELEMETRY_DISABLED=true
# Choose cloud to keep research, shared sessions and improvement on your tenant.
COGNEE_TEAM_RUNTIME=local
COGNEE_SERVICE_URL=
COGNEE_API_KEY=
# Live deployment only: server-side application state and durable orchestration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ATLAS_DEMO_ACCESS_CODE=
# Keep local defaults for local development; set these in Vercel.
# ATLAS_JOB_RUNTIME=vercel
# ATLAS_STATE_DIR=/tmp/contract-atlas
